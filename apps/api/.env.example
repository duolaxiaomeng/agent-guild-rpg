NODE_ENV=development
PORT=3001
DATABASE_URL=file:./prisma/dev.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# Required in production. Keep real values outside the repository.
CONNECTOR_PUBLIC_API_URL=http://localhost:3001
CONNECTOR_CREDENTIAL_SIGNING_SECRET=replace-with-at-least-32-random-characters
REGISTRATION_INTERNAL_CODE=replace-with-a-private-registration-code

# Optional infrastructure and LLM integration.
REDIS_URL=
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-turbo-260628
