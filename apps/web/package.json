{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "start": "next start --port 3000 --hostname 0.0.0.0",
    "dev:e2e": "next dev --port 3100",
    "start:e2e": "next start --port 3100",
    "e2e:server": "pnpm build && pnpm start:e2e",
    "build": "next build",
    "build:site": "opennextjs-cloudflare build",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "contracts": "workspace:*",
    "next": "^15.4.0",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.110.0"
  }
}
