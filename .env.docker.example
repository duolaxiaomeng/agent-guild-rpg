# Browser-visible origins used for local Docker deployment.
PUBLIC_WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
ALLOW_INSECURE_LOCALHOST=1

# Replace both values before starting the stack. Do not commit real secrets.
CONNECTOR_CREDENTIAL_SIGNING_SECRET=replace-with-at-least-32-random-characters
REGISTRATION_INTERNAL_CODE=replace-with-a-private-registration-code

# Optional ARK / Doubao integration. Empty keeps rule-based fallback enabled.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-turbo-260628
